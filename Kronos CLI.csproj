<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>KronosCLI</RootNamespace>
    <Configurations>Release</Configurations>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <OutputPath>obj\build\</OutputPath>
    <PublishDir>bin\</PublishDir>

    <ApplicationIcon>asteroid.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <Target Name="BundleSingleExe"
          AfterTargets="Build"
          Condition="'$(NoBuild)' != 'true' and '$(_IsPublishing)' != 'true' and '$(DesignTimeBuild)' != 'true'">

    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Publish"
             Properties="NoBuild=true" />

  </Target>

</Project>
